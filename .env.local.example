# FireworksAI
FIREWORKS_API_KEY=fw_xxx

# Daytona
DAYTONA_API_KEY=daytona_xxx
DAYTONA_SERVER_URL=https://app.daytona.io/api

# Braintrust
BRAINTRUST_API_KEY=bt_xxx

# ElevenLabs & Twilio
ELEVENLABS_API_KEY=el_xxx
ELEVENLABS_AGENT_ID=agent_1101kyah0r50fmbbx9zh0vd7yegc
# ID (phnum_...) of a Twilio number imported into ElevenLabs (Conversational AI -> Phone Numbers).
# Get it from POST /v1/convai/phone-numbers, NOT the raw +E.164 number.
ELEVENLABS_PHONE_NUMBER_ID=phnum_xxx
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890
ON_CALL_PHONE_NUMBER=+1987654321

# GitHub (classic PAT, repo scope) & Discord
GITHUB_TOKEN=ghp_xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx

# Fallback repo for Sentry incidents (Sentry payloads carry no repo URL)
DEFAULT_REPO_URL=https://github.com/the-builders-burrow/VoiceSRE

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telephony bridge (Twilio Media Streams <-> ElevenLabs). No number import needed.
BRIDGE_URL=http://localhost:8080
BRIDGE_PORT=8080
# Public https tunnel to the bridge port (e.g. cloudflared). Set at runtime, no trailing slash.
PUBLIC_URL=https://your-tunnel.trycloudflare.com
